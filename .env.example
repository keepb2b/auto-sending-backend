# Copy to .env and fill in values. Never commit .env.

# ── Required for API + storing companies / replies ─────────────────────────────
# Postgres connection (e.g. Supabase pooler URI from Dashboard → Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# ── SMTP (bulk send via sendEmail/mailer.py) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional: contact form / notifications if used elsewhere
# CONTACT_EMAIL_TO=
# DAILY_LIMIT=500

# ── IMAP (POST /api/replies/check → sendEmail/reply_checker.py) ──────────────
# Uses SMTP_USER / SMTP_PASSWORD if IMAP_USER / IMAP_PASSWORD are empty
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX
# IMAP_USER=
# IMAP_PASSWORD=

# How far back to search INBOX (1 = recent only; uppercase alias: REPLY_FETCH_DAYS)
reply_fetch_days=1

# ── API server (optional) ────────────────────────────────────────────────────
# API_HOST=0.0.0.0
# API_PORT=8000
# HOST=127.0.0.1
# PORT=8000

# ── Supabase REST (optional; if your app reads these from backend) ───────────
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_PUBLISHABLE_KEY=
